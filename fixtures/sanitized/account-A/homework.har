            "text": "[\n[new Date(2026,3,27,0,0,0,0), 1379529, 3, \"Родная страна и страны изучаемого языка (столицы, основные достопримечательности, интересные факты, популярные сувениры)\", \"\", null, 1, null, null, 49, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379661, 3, \"Родная страна и страны изучаемого языка (сказки)\", \"\", null, 2, null, null, 4233, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379823, 406, \"Как мусор получает \\n«вторую жизнь»? \\nТехнологии переработки\", \"\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379824, 1, \"Отрабатываем правописание суффиксов и окончаний глаголов в прошедшем времени\", \"Повторить правила -ться, -ешь/-ишь\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379825, 11, \"Мудрость старости: создаем живописный портрет пожилого человека \", \"\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379826, 2, \"Книги о приключениях и фантастике\", \"Выполнить устно задания с. 165-166. ЗАВТРА ВПР ПО ОКРУЖАЮЩЕМУ МИРУ. Повторить природные зоны, расположение материков, строение тела человека (задания 2, 3, 4 на портале \\\"РЕШУ ВПР\\\")\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1380235, 2, \"Зарубежные писатели-сказочники: раскрытие главной мысли и особенности композиции\", \"Выполнить устно задания 1- 3 с. 193\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1380236, 5, \"Решение задач на работу\", \"Выполнить устно №286, №288\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1380237, 1, \"Морфологический разбор глагола\", \"Подготовиться к словарному диктанту с. 152\", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1380238, 8, \"Государственные праздники России\", \"Подготовить пересказ с. 180-182 \", null, 1, null, null, 3883, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380447, 12, \"Плавание кролем на спине в полной координации\", \"Выполнить комплекс УГ\", 