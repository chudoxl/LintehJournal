            "size": 5140,
            "mimeType": "text/plain; charset=UTF-8",
            "text": "[\n[new Date(2026,3,27,0,0,0,0), 1379083, 1, \"Сочинение на морально-этическую тему (обучающее)\", \"Выполнить упр. 639 (по заданию)\", \"4\", 1, null, null, 4171, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379375, 1, \"Сочинение на морально-этическую тему (обучающее)\", null, \"3\", 1, 1379083, null, 4171, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379403, 16, \"Р.И. Фраерман. «Дикая собака Динго, или Повесть о первой любви». Проблематика повести\", \"\", \"2\", 1, null, null, 4171, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379651, 19, \"Всероссийская проверочная работа/ ИТОГОВАЯ контрольная работа\", \"Решаем варианты на сайте РЕшу ВПР по географии 6 класс . Готовимся к итоговой контрольной работе или ВПР. На следующей неделе пишем работы! Оценка на 13.04 стоит за рабочий лист!\", null, 1, null, null, 4252, 0, null],\n [new Date(2026,3,27,0,0,0,0), 1379786, 7, null, \"Прочитать параграф 1 электронного пособия по истории нашего края в тимс, придумать 3 вопроса по параграфу \", null, 1, null, null, 4258, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1379377, 1, \"Переходные и непереходные глаголы\", \"Оценки за устный зачёт\", \"1\", 1, null, null, 4171, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1379378, 1, \"Переходные и непереходные глаголы. Практикум\", \"Оценки за ведение тетради. \", \"1\", 1, null, null, 4171, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1379878, 5, \"Решение уравнений.\", \"Прочитать § 40, выучить правила. Выполнить № 5.124.\", null, 1, null, null, 1613, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1379962, 3, \"Родная страна и страна (страны) изучаемого языка (праздники)\", \"Выполнить в грам трен с. 71 упр. 11,13\", null, 2, null, null, 3425, 0, null],\n [new Date(2026,3,28,0,0,0,0), 1380055, 3, \"Родная страна и страна (страны) изучаемого языка (праздники)\", \"Выполнить задание в Тимс (задание 3 ВПР)\", null, 1, null, null, 2011, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1379379, 1, \"Разноспрягаемые глаголы\", \"\", null, 1, null, null, 4171, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1379404, 16, \"Внеклассное чтение. Ю.И. Коваль. Повесть «Самая лёгкая лодка в мире». Система образов\", \"\", null, 1, null, null, 4171, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380307, 5, \"Решение уравнений.\", \"Прочитать § 40, выучить правила. Выполнить № 5.102, 5.103.\", null, 1, null, null, 1613, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380330, 3, \"Родная страна и страна (страны) изучаемого языка (празднуем вместе)\", \"Выполнить любой вариант ВПР в интернете\", null, 1, null, null, 2011, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380422, 13, \"Практическая работа «Программирование работы датчика расстояния»\", \"Решить задачи \\\"Буква П\\\", \\\"Квадрат\\\", \\\"Кегельринг\\\" и \\\"Доставка\\\" на платформе Кулибин (Соревнования-Архив-Кузнецов К.К. 2023)\", null, 2, null, null, 4243, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380423, 13, \"Датчики линии, назначение и функции\", \"Решить задачи \\\"Буква П\\\", \\\"Квадрат\\\", \\\"Кегельринг\\\" и \\\"Доставка\\\" на платформе Кулибин (Соревнования-Архив-Кузнецов К.К. 2023)\", null, 2, null, null, 4243, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380426, 3, \"Родная страна и страна (страны) изучаемого языка (празднуем вместе)\", \"Выполнить в грам трен с. 71 упр. 11,13\", null, 2, null, null, 3425, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380429, 13, \"Датчики расстояния, назначение и функции\", \"\", null, 1, null, null, 4242, 0, null],\n [new Date(2026,3,29,0,0,0,0), 1380431, 13, \"Практическая работа «Программирование работы датчика расстояния»\", \"\", null, 1, null, null, 4242, 0, null],\n [new Date(2026,3,30,0,0,0,0), 1379380, 1, \"Разноспрягаемые глаголы (закрепление). Практикум\", \"\", null, 1, null, null, 4171, 0, null]\n]"
